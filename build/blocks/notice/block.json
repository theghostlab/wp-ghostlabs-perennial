{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ghostlabs/dynamic-copyright",
  "version": "1.0.0",
  "title": "Dynamic Copyright: Notice",
  "category": "widgets",
  "icon": "editor-paragraph",
  "description": "A copyright notice that keeps its year and site name current automatically.",
  "keywords": [
    "copyright",
    "footer",
    "year",
    "legal"
  ],
  "example": {},
  "attributes": {
    "from": {
      "type": "string",
      "default": ""
    },
    "owner": {
      "type": "string",
      "default": ""
    },
    "statementOfRights": {
      "type": "boolean",
      "default": false
    },
    "yearColor": {
      "type": "string"
    },
    "customYearColor": {
      "type": "string"
    },
    "yearFontSize": {
      "type": "string"
    },
    "customYearFontSize": {
      "type": "string"
    },
    "yearFontWeight": {
      "type": "string"
    }
  },
  "supports": {
    "html": false,
    "align": true,
    "color": {
      "text": true,
      "background": true,
      "link": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    }
  },
  "textdomain": "ghostlabs-dynamic-copyright",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}